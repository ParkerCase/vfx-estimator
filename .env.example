# --- Paths ---
# Legacy numeric: prefer vendored copy (python -m scripts.vendor_legacy_pipeline)
# or point at monorepo apps/breakdown once, then vendor. Leave empty if using fallback only.
VFX_LEGACY_BREAKDOWN_ROOT=

# Training / holdout (local copies in vfx-estimator/data/ after Phase B)
VFX_TRAINING_JSON=/absolute/path/to/vfx-estimator/data/retraining_bundle.json
VFX_SHOT_TRAINING_JSONL=/absolute/path/to/MuseAI-xata/apps/breakdown/data/processed/shot_training_rows.jsonl
VFX_BYZANTINE_CSV=/absolute/path/to/MuseAI-xata/apps/breakdown/data/byzantine_actual_expanded.csv

# Local project data dir (corrections, tuning, reports)
VFX_ESTIMATOR_DATA_DIR=./data

# --- Google Sign-In (dashboard / landing) ---
# OAuth 2.0 Web client ID from Google Cloud Console.
# Authorized JavaScript origins must include:
#   http://127.0.0.1:8090 (local) and https://vfx-estimator.vercel.app (prod)
GOOGLE_CLIENT_ID=

# --- Gemini (mandays RAG + structured breakdown) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MANDAYS_MODEL=gemini-2.5-flash

# --- Xata (optional live search + corrections persistence) ---
# Do NOT commit real keys or passwords.
XATA_API_KEY=
# Postgres URL from Xata Connect → Postgres (shot search + vfx_corrections table)
XATA_POSTGRES_URL=postgresql://xata:PASSWORD@HOST:5432/?sslmode=require
# Alias (optional): same Postgres URL
XATA_DATABASE_URL=
XATA_BRANCH=main
XATA_TABLE=vfx_historical_shots
XATA_CORRECTIONS_TABLE=vfx_corrections
# One-time per environment: python -m scripts.migrate_xata_corrections

# --- Estimator tuning (also editable in data/tuning.json) ---
VFX_ESTIMATE_MODE=hybrid
# numeric_only | gemini_rag | hybrid
VFX_BLEND_NUMERIC_WEIGHT=0.55
VFX_BLEND_GEMINI_WEIGHT=0.45
VFX_CORRECTION_BOOST=2.0
VFX_RETRIEVAL_TOP_K=10
VFX_DAY_RATE=700
VFX_USE_LEGACY_NUMERIC=1

# --- API ---
VFX_API_HOST=127.0.0.1
VFX_API_PORT=8090
