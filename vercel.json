{
  "version": 2,
  "builds": [
    { "src": "frontend/dashboard.html", "use": "@vercel/static" },
    { "src": "frontend/estimate_ui.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "frontend/dashboard.html" },
    { "src": "/dashboard", "dest": "frontend/dashboard.html" },
    { "src": "/estimate", "dest": "frontend/estimate_ui.html" }
  ]
}
